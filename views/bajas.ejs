<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Baja de Alumno</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <div class="container py-4">

    <nav class="mb-4">
      <a href="/" class="btn btn-outline-secondary btn-sm">← Inicio</a>
    </nav>

    <div class="row justify-content-center">
      <div class="col-md-8">
        <div class="card shadow-sm">
          <div class="card-header bg-danger text-white">
            <h4 class="mb-0">🗑️ BAJA DE ALUMNO</h4>
          </div>
          <div class="card-body">

            <!-- Buscar por número de control -->
            <h6 class="fw-bold">Buscar alumno por Número de Control:</h6>
            <form method="GET" action="/alumnos/buscar-baja" class="row g-2 mb-4">
              <div class="col-md-8">
                <input type="text" name="numControl" class="form-control"
                       placeholder="Ingresa el número de control..." maxlength="8"
                       value="<%= typeof busqueda !== 'undefined' ? busqueda : '' %>">
              </div>
              <div class="col-md-4">
                <button type="submit" class="btn btn-danger w-100">🔎 Buscar</button>
              </div>
            </form>

            <!-- Tarjeta de confirmación si se encontró el alumno -->
            <% if (typeof alumno !== 'undefined' && alumno) { %>
              <div class="card border-danger">
                <div class="card-body">
                  <h5 class="text-danger fw-bold">⚠️ ¿Deseas eliminar este alumno?</h5>
                  <table class="table table-bordered mt-3">
                    <tr><th>N° Control</th><td><%= alumno.numControl %></td></tr>
                    <tr><th>Nombre</th><td><%= alumno.nombre %> <%= alumno.primerAp %> <%= alumno.segundoAp %></td></tr>
                    <tr><th>Fecha de Nacimiento</th><td><%= alumno.fechaNac %></td></tr>
                    <tr><th>Semestre</th><td><%= alumno.semestre %>°</td></tr>
                    <tr><th>Carrera</th><td><%= alumno.carrera %></td></tr>
                  </table>

                  <form method="POST" action="/alumnos/<%= alumno._id %>?_method=DELETE">
                    <div class="d-flex gap-2">
                      <button type="submit" class="btn btn-danger">🗑️ Confirmar Eliminación</button>
                      <a href="/bajas" class="btn btn-secondary">✖ Cancelar</a>
                    </div>
                  </form>
                </div>
              </div>
            <% } else if (typeof busqueda !== 'undefined' && busqueda) { %>
              <div class="alert alert-warning">No se encontró ningún alumno con ese número de control.</div>
            <% } %>

          </div>
        </div>
      </div>
    </div>

    <footer class="text-muted text-center mt-4 mb-3">FOOTER</footer>
  </div>
</body>
</html>