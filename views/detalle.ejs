<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Detalle Alumno</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-white">

  <div class="text-center py-4 border-bottom">
    <h1 class="fw-bold">SERVICIOS ESCOLARES</h1>
  </div>

  <div class="container mt-3">

    <nav class="mb-3">
      <span><a href="/" class="text-decoration-none">Inicio</a> / <a href="/consultas" class="text-decoration-none">Alumnos</a> / Detalle</span>
    </nav>

    <div class="card shadow-sm">
      <div class="card-header bg-dark text-white">
        <span class="fw-bold fs-5">Detalle del Alumno</span>
      </div>
      <div class="card-body">
        <table class="table table-bordered">
          <tr><th>Número de Control</th><td><%= alumno.numControl %></td></tr>
          <tr><th>Nombre</th><td><%= alumno.nombre %></td></tr>
          <tr><th>Primer Apellido</th><td><%= alumno.primerAp %></td></tr>
          <tr><th>Segundo Apellido</th><td><%= alumno.segundoAp %></td></tr>
          <tr><th>Fecha de Nacimiento</th><td><%= alumno.fechaNac %></td></tr>
          <tr><th>Semestre</th><td><%= alumno.semestre %>°</td></tr>
          <tr><th>Carrera</th><td><%= alumno.carrera %></td></tr>
        </table>
        <div class="d-flex gap-2 mt-2">
          <a href="/alumnos/editar/<%= alumno._id %>" class="btn btn-warning">Editar</a>
          <a href="/consultas" class="btn btn-secondary">Regresar</a>
        </div>
      </div>
    </div>

  </div>

  <footer class="text-muted text-center mt-4 mb-3">FOOTER</footer>

</body>
</html>