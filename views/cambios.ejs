<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Editar Alumno</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-white">

  <div class="text-center py-4 border-bottom">
    <h1 class="fw-bold">SERVICIOS ESCOLARES</h1>
  </div>

  <div class="container mt-3">

    <nav class="mb-3">
      <span><a href="/" class="text-decoration-none">Inicio</a> / <a href="/consultas" class="text-decoration-none">Alumnos</a> / Editar</span>
    </nav>

    <div class="card shadow-sm">
      <div class="card-header bg-dark text-white">
        <span class="fw-bold fs-5">Editar Alumno</span>
      </div>
      <div class="card-body">
        <form method="POST" action="/alumnos/<%= alumno._id %>?_method=PUT">

          <div class="mb-3">
            <label class="form-label fw-bold">Número de Control:</label>
            <input class="form-control" name="numControl" type="text" maxlength="8" required value="<%= alumno.numControl %>">
          </div>

          <div class="mb-3">
            <label class="form-label fw-bold">Nombre:</label>
            <input class="form-control" name="nombre" type="text" required value="<%= alumno.nombre %>">
          </div>

          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label fw-bold">Primer Apellido:</label>
              <input class="form-control" name="primerAp" type="text" required value="<%= alumno.primerAp %>">
            </div>
            <div class="col-md-6 mb-3">
              <label class="form-label fw-bold">Segundo Apellido:</label>
              <input class="form-control" name="segundoAp" type="text" required value="<%= alumno.segundoAp %>">
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label fw-bold">Fecha de Nacimiento:</label>
            <input class="form-control" name="fechaNac" type="date" required value="<%= alumno.fechaNac %>">
          </div>

          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label fw-bold">Semestre:</label>
              <select class="form-select" name="semestre" required>
                <% for(let i = 1; i <= 12; i++) { %>
                  <option value="<%= i %>" <%= alumno.semestre == i ? 'selected' : '' %>><%= i %>° Semestre</option>
                <% } %>
              </select>
            </div>
            <div class="col-md-6 mb-3">
              <label class="form-label fw-bold">Carrera:</label>
              <select class="form-select" name="carrera" required>
                <option value="ISC" <%= alumno.carrera === 'ISC' ? 'selected' : '' %>>Ing. en Sistemas Computacionales</option>
                <option value="IMT" <%= alumno.carrera === 'IMT' ? 'selected' : '' %>>Ing. en Mecatrónica</option>
                <option value="IIA" <%= alumno.carrera === 'IIA' ? 'selected' : '' %>>Ing. en Industria Alimentaria</option>
                <option value="LA"  <%= alumno.carrera === 'LA'  ? 'selected' : '' %>>Lic. en Administración</option>
                <option value="CP"  <%= alumno.carrera === 'CP'  ? 'selected' : '' %>>Contaduría</option>
              </select>
            </div>
          </div>

          <div class="d-flex gap-2 mt-2">
            <button type="submit" class="btn btn-warning">Guardar Cambios</button>
            <a href="/consultas" class="btn btn-secondary">Cancelar</a>
          </div>

        </form>
      </div>
    </div>

  </div>

  <footer class="text-muted text-center mt-4 mb-3">FOOTER</footer>

</body>
</html>